# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional default server-side GitHub Personal Access Token for automated repo sync
GITHUB_DEFAULT_TOKEN=

# Optional default Webhook URL for direct file persistence
DEFAULT_WEBHOOK_URL=
